{
  "compilerOptions": {
    "strict": true,
    "rootDir": "./src/",
    "outDir": "./dist/",
    "sourceMap": true,
    "noImplicitAny": true,
    "declaration": true,
    "module": "commonjs",
    "target": "ES2022",
    "esModuleInterop": true,
    "lib": ["ES2022"],
    "types": ["node"]
  },
  "include": ["./src/**/*"]
}
